# routewisp environment contract

# Runtime
PORT=20128
HOSTNAME=0.0.0.0
DATA_DIR=/var/lib/routewisp

# Admin API (/api/keys, /api/providers, /api/combos, /api/oauth/*/bulk-import, ...)
# Required on a public VPS — generate with: openssl rand -hex 32
# If unset, a random one is generated per-restart and printed to stdout (never
# left open by default, but not stable across restarts).
ADMIN_TOKEN=

# Per-API-key request limit on /v1/*, /v1beta/* (fixed window, requests/min). 0 disables.
RATE_LIMIT_PER_MINUTE=60

# API-key hashing / machine-id salt — change from the defaults for a public deploy
API_KEY_SECRET=change-me
MACHINE_ID_SALT=change-me

# Optional request logging (off by default)
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true

# Optional outbound proxy for upstream provider calls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider
# SEARXNG_URL=http://searxng:8080/search
